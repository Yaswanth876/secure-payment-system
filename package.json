{
  "name": "payment-guardian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "db:migrate": "node database/db.js migrate",
    "db:seed": "node database/db.js seed",
    "db:setup": "node database/db.js setup",
    "db:reset": "node database/db.js reset",
    "db:test": "node database/db.js test",
    "test:backend": "npm run db:reset && node --test backend/tests/backend.test.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "sqlite3": "^6.0.1"
  }
}
